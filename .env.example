# Base URL of the Agenda Canina API, must end with a trailing slash.
# e.g. https://api.agendacanina.com/ or http://localhost:3000/
VITE_API_URL=

# Firebase Web SDK config (Firebase console > Project settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Sign-In: the Google provider is enabled/configured directly in the
# Firebase console (Authentication > Sign-in method > Google) and normally
# needs no extra client id here. VITE_GOOGLE_CLIENT_ID is kept only in case
# you need to reference the OAuth Web Client ID (Google Cloud Console >
# APIs & Services > Credentials) for anything outside of Firebase Auth.
VITE_GOOGLE_CLIENT_ID=

# Facebook Sign-In: create/enable the provider in Firebase console
# (Authentication > Sign-in method > Facebook), which requires a Facebook App
# ID + App Secret from developers.facebook.com. VITE_FACEBOOK_APP_ID is kept
# for reference / any direct Facebook SDK usage outside of Firebase Auth.
VITE_FACEBOOK_APP_ID=
